@model List<Notification>
@{ ViewData["Title"] = "Notifications"; }
<div class="page-head"><h3>Notifications</h3><a asp-action="Audit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clock-history"></i>@L["Audit"]</a></div>
<partial name="_Guide" model='"notifications"' />
<div class="card"><div class="table-responsive"><table class="table table-sm mb-0 m-cards">
    <thead><tr><th>@L["At"]</th><th>@L["Event"]</th><th>To</th><th>Subject</th><th>OK</th></tr></thead>
    <tbody>@foreach (var n in Model) { <tr><td data-label="">@L.DateTimeStr(n.SentAt.ToLocalTime()) <span class="ms-1">@(n.Success ? "✔" : "✘")</span></td><td data-label="@L["Event"]">@n.EventRequestId</td><td data-label="To">@n.Recipient</td><td data-label="Subject">@n.Subject</td><td data-label="@L.T("Error", "الخطأ")" class="@(n.Success ? "m-hide" : "")">@n.Error</td></tr> }</tbody>
</table></div></div>
