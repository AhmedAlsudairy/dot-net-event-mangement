<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0B3D5C" />
    <title>@L["App"]</title>
    @if (L.IsAr) { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" /> }
    else { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /> }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="public-wrap">
    <div class="pub-head">
        <span class="brand"><span class="brand-mark"><i class="bi bi-calendar2-event"></i></span>@L["App"]</span>
        <form method="post" action="/lang">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button class="btn btn-sm btn-outline-light" name="lang" value="@(L.IsAr ? "en" : "ar")"><i class="bi bi-translate"></i> @(L.IsAr ? "English" : "العربية")</button>
        </form>
    </div>
    <div class="pub-body">
        @RenderBody()
    </div>
</div>
<script>
    document.addEventListener('submit', function (e) {
        var b = e.submitter; if (!b || !e.target.checkValidity()) return;
        setTimeout(function () { b.classList.add('is-loading'); b.insertAdjacentHTML('afterbegin', '<span class="spinner-border spinner-border-sm"></span>'); }, 0);
    });
</script>
</body>
</html>
