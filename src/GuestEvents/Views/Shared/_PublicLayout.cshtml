<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir" data-bs-theme="@(Theme.Mode == "dark" ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script>(function () { var m = '@Theme.Mode', lock = @(Theme.Locked ? "true" : "false"); try { var u = localStorage.getItem('themeMode'); if (u && !lock) m = u; } catch (e) { }
        if (m === 'auto') m = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.setAttribute('data-bs-theme', m);
        try { var fs = localStorage.getItem('fontScale'); if (fs && !lock) document.documentElement.style.setProperty('--font-scale', (parseInt(fs, 10) / 100).toString()); } catch (e) { } })();</script>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0B3D5C" />
    <title>@L["App"]</title>
    @if (L.IsAr) { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" /> }
    else { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /> }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @if (Brand.Has) { <link rel="icon" href="/brand/logo?v=@Brand.Version" /> }
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @Html.Raw(Fonts.HeadHtml)
    <style id="theme-css">@Html.Raw(Fonts.Css)@Html.Raw(Theme.Css)</style>
</head>
<body>
<div class="public-wrap">
    <div class="pub-head">
        <span class="brand"><partial name="_BrandMark" />@L["App"]</span>
        <form method="post" action="/lang">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button class="btn btn-sm btn-outline-light" name="lang" value="@(L.IsAr ? "en" : "ar")"><i class="bi bi-translate"></i> @(L.IsAr ? "English" : "العربية")</button>
        </form>
    </div>
    <div class="pub-body">
        @RenderBody()
    </div>
</div>
<script>
    document.addEventListener('submit', function (e) {
        var b = e.submitter; if (!b || !e.target.checkValidity()) return;
        setTimeout(function () { b.classList.add('is-loading'); b.insertAdjacentHTML('afterbegin', '<span class="spinner-border spinner-border-sm"></span>'); }, 0);
    });
</script>
</body>
</html>
