@model EventRequest
@{ ViewData["Title"] = L["Screen"]; bool rotating = ViewBag.Rotating == true; }
<partial name="_Guide" model='"screen"' />
<div class="text-center py-3">
    <h2 class="fw-bold">@Model.Name</h2>
    <p class="text-muted fs-5"><i class="bi bi-geo-alt"></i> @Model.Venue &nbsp; <i class="bi bi-calendar3"></i> @L.Range(Model) @L.Times(Model)</p>
    <img id="qr" class="screen-qr bg-white p-3 rounded-4 shadow-sm" src="@Url.Action("ScreenQr", new { id = Model.Id })" alt="QR" />
    <p class="fs-5 mt-3 mb-1"><i class="bi bi-phone"></i> @L["ScanToCheckIn"]</p>
    @if (rotating) { <p class="text-muted"><i class="bi bi-arrow-repeat"></i> <span id="cd">60</span> s</p> }
</div>
@section Scripts {
@if (rotating)
{
<script>
    var left = 60;
    setInterval(function () {
        left--; if (left <= 0) { left = 60; document.getElementById('qr').src = '@Url.Action("ScreenQr", new { id = Model.Id })?t=' + Date.now(); }
        document.getElementById('cd').textContent = left;
    }, 1000);
</script>
}
}
