@model EventRequest
@{
    Layout = null;
    bool rotating = ViewBag.Rotating == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Name - QR</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="py-3">
<div class="container">
    <div class="no-print d-flex justify-content-between align-items-center mb-3">
        <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.Id })"><i class="bi bi-arrow-left"></i> @L["Back"]</a>
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print / طباعة</button>
    </div>
    @if (rotating)
    {
        <div class="alert alert-warning no-print"><i class="bi bi-exclamation-triangle"></i> The rotating QR is switched on: a printed code would not work. Use the <a href="@Url.Action("Screen", new { id = Model.Id })">Venue screen</a> instead. / الرمز المتغيّر مفعّل: الرمز المطبوع لن يعمل. استخدم <a href="@Url.Action("Screen", new { id = Model.Id })">شاشة القاعة</a>.</div>
    }
    else
    {
    <div class="poster">
        <h2 class="fw-bold mb-1">@Model.Name</h2>
        <div class="text-muted fs-5">@Model.Presenter &middot; @Model.Venue &middot; @L.Range(Model) @L.Times(Model)</div>
        <img class="qr my-3" src="@Url.Action("DownloadQr", new { id = Model.Id })" alt="QR" />
        <h3 class="fw-bold">Scan to check in &nbsp;|&nbsp; <span dir="rtl">امسح لتسجيل الحضور</span></h3>
        <div class="cols">
            <div dir="ltr">
                <h5>How to check in</h5>
                <ol>
                    <li>Open your phone <b>camera</b> and point it at the code.</li>
                    <li>Tap the link that appears.</li>
                    <li>Type your <b>name</b> and <b>organization</b>, then press <b>Check in</b>.</li>
                    <li>After the event, tap <b>Evaluate</b> and rate it (anonymous).</li>
                </ol>
                <div class="small text-muted">No app or account needed.</div>
            </div>
            <div dir="rtl">
                <h5>طريقة تسجيل الحضور</h5>
                <ol>
                    <li>افتح <b>كاميرا</b> هاتفك ووجّهها نحو الرمز.</li>
                    <li>اضغط على الرابط الذي يظهر.</li>
                    <li>اكتب <b>اسمك</b> و<b>الجهة</b> ثم اضغط <b>تسجيل الحضور</b>.</li>
                    <li>بعد الفعالية اضغط <b>قيّم</b> وأجب (مجهول الهوية).</li>
                </ol>
                <div class="small text-muted">لا حاجة لتطبيق أو حساب.</div>
            </div>
        </div>
    </div>
    }
</div>
</body>
</html>
