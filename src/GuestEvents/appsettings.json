{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Db": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Default": "Data Source=App_Data/events.db" },
  "Auth": { "Mode": "Ldap", "Sso": false },
  "Ldap": {
    "Host": "dc.company.local",
    "Port": 636,
    "UseSsl": true,
    "SkipCertValidation": false,
    "BaseDn": "DC=company,DC=local",
    "ServiceAccountDn": "CN=svc-events,OU=Service,DC=company,DC=local",
    "ServiceAccountPassword": "SET-VIA-USER-SECRETS-OR-ENV",
    "GroupStaff": "Events-Staff",
    "GroupHod": "Events-HOD",
    "GroupMedia": "Events-Media",
    "GroupAdmin": "Events-Admin"
  },
  "Smtp": { "Enabled": false, "Host": "smtp.company.local", "Port": 25, "UseStartTls": true, "User": "", "Password": "", "From": "events@company.local" },
  "App": {
    "InternalBaseUrl": "https://events.company.local",
    "PublicBaseUrl": "https://qr.company.com",
    "PublicHost": "qr.company.com",
    "HodEmail": "hod@company.local",
    "BootstrapAdmins": ""
  },
  "Public": { "RequestsPerMinutePerIp": 60, "SubmitsPerMinutePerIp": 30 },
  "Security": { "HashSecret": "CHANGE-ME-LONG-RANDOM-VALUE" }
}
